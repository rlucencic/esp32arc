diff --git a/components/arm2/arm2.c b/components/arm2/arm2.c
index 768a1e0..3a57bf5 100644
--- a/components/arm2/arm2.c
+++ b/components/arm2/arm2.c
@@ -919,7 +919,8 @@ static INLINE void coprocessor(arm2_t *c, run_t *r, uint32_t op, uint32_t pc)
 #define X16(l)          X8(l), X8(l)
 #define X64(l)          X16(l), X16(l), X16(l), X16(l)
 #define X256(l)         X64(l), X64(l), X64(l), X64(l)
-#define COND_ROW        X64(cond), X64(cond), X16(cond), X16(cond), X16(cond_b), X16(cond_bl), X64(cond)
+#define COND_ROW(name)  X64(cond_##name), X64(cond_##name), X16(cond_##name), X16(cond_##name), \
+                        X16(cond_b_##name), X16(cond_bl_##name), X64(cond_##name)
 #define BLK_ROW        X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), \
                         X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), \
                         X2(stm_ldm), X2(stm_ldm), X2(stm_ldm), X2(stm_ldm)
@@ -990,13 +991,23 @@ void arm2_host_hook(arm2_t *c);         /* host builds: tracing */
         if (UNLIKELY(op & 0x10)) goto undefined;                                \
         single_transfer(c, r, op, PC, load, byte, true); NEXT();
 
-#define COND_PASSES()   ((c->cond_mask >> (op >> 28)) & 1)
+/* The table already supplies the condition, so test a constant mask bit. */
+#define CONDITION(name, bit)                                                    \
+    cond_##name:                                                               \
+        if (!(c->cond_mask & (1u << bit))) goto next;                            \
+        goto *ops[0xE00 | ((op >> 20) & 0xFF)];                                  \
+    cond_b_##name:                                                             \
+        if (!(c->cond_mask & (1u << bit))) goto next;                            \
+        goto b;                                                                \
+    cond_bl_##name:                                                            \
+        if (!(c->cond_mask & (1u << bit))) goto next;                            \
+        goto bl;
 
 int32_t ARM2_HOT arm2_run(arm2_t *c, int32_t ticks)
 {
     static const void *const ops[4096] = {
-        COND_ROW, COND_ROW, COND_ROW, COND_ROW, COND_ROW, COND_ROW, COND_ROW,   /* EQ-VC */
-        COND_ROW, COND_ROW, COND_ROW, COND_ROW, COND_ROW, COND_ROW, COND_ROW,   /* HI-LE */
+        COND_ROW(eq), COND_ROW(ne), COND_ROW(cs), COND_ROW(cc), COND_ROW(mi), COND_ROW(pl), COND_ROW(vs),
+        COND_ROW(vc), COND_ROW(hi), COND_ROW(ls), COND_ROW(ge), COND_ROW(lt), COND_ROW(gt), COND_ROW(le),
         DP_ROW(r), DP_ROW(i),                   /* E00-E3F data processing (and multiplies) */
         ST_ROW(i), ST_ROW(r),                   /* E40-E7F LDR, STR */
         BLK_ROW,                                /* E80-E9F LDM, STM */
@@ -1052,11 +1063,10 @@ decoded: __attribute__((unused));       /* the debugger's way back in */
     insns++;
     goto *ops[op >> 20];
 
-cond:
-    if (!COND_PASSES()) {
-        goto next;
-    }
-    goto *ops[0xE00 | ((op >> 20) & 0xFF)];
+    CONDITION(eq, 0) CONDITION(ne, 1) CONDITION(cs, 2) CONDITION(cc, 3)
+    CONDITION(mi, 4) CONDITION(pl, 5) CONDITION(vs, 6) CONDITION(vc, 7)
+    CONDITION(hi, 8) CONDITION(ls, 9) CONDITION(ge, 10) CONDITION(lt, 11)
+    CONDITION(gt, 12) CONDITION(le, 13)
 
 #if EMUDBG_ENABLED
 debug:
@@ -1114,17 +1124,9 @@ stm_ldm:
     /* B, BL: R14 gets the next instruction's address and the PSR. The
      * target isn't masked (as the PC in NEXT()).
      */
-cond_bl:
-    if (!COND_PASSES()) {
-        goto next;
-    }
 bl:
     c->r[14] = (r->pc & ARM2_PC) | c->psr;
     goto b;
-cond_b:
-    if (!COND_PASSES()) {
-        goto next;
-    }
 b:
     r->pc += 4 + (uint32_t)((int32_t)(op << 8) >> 6);
     r->left -= 3;
